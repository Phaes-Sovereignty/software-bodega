# factory/toolchain.env — Swift (SwiftPM or Xcode)
#
# Copy to factory/toolchain.env in your project and adjust. Declares how THIS
# project is built and verified; models.env stays untouched.

# --- SwiftPM ---------------------------------------------------------------
VISIBLE_CMD='swift test --filter VisibleTests'
# --manifest-cache none is NOT optional here. Package.swift declares the
# held-out target only when its directory is present (that is what lets the
# visible build survive the seal), and SwiftPM caches the evaluated manifest
# keyed on the manifest's CONTENTS, not on the filesystem it inspected. Without
# the flag this run can reuse a manifest evaluated while the seal was in the
# other state, silently drop the target, and report "Executed 0 tests" as a pass.
HELDOUT_CMD='swift test --manifest-cache none --filter HeldoutTests'
BUILD_CMD='swift build'

# --- Xcode (uncomment instead of the above) --------------------------------
# SCHEME=MyApp
# DEST='platform=iOS Simulator,name=iPhone 16'
# VISIBLE_CMD="xcodebuild test -scheme $SCHEME -destination '$DEST' -only-testing:VisibleTests"
# HELDOUT_CMD="xcodebuild test -scheme $SCHEME -destination '$DEST' -only-testing:HeldoutTests"
# BUILD_CMD="xcodebuild build -scheme $SCHEME -destination '$DEST'"

# Project-level invariant checked on EVERY verification, alongside the suite.
# Fails the task even when the tests are green, and counts as one failing check
# in the no-regression arithmetic — so BREAKING the invariant fails the task,
# while one that was already red is inherited rather than blamed on the task.
# Point it at your own script. Leave it EMPTY if you have no such check; an
# invented one that always passes is worse than none.
EXTRA_GATE_CMD='bash scripts/check-target-graph.sh'

# Swift builds are slower than the shell default assumes. A cold SwiftPM build
# plus a simulator boot can exceed 30 minutes on a large app.
FACTORY_ROLE_TIMEOUT=5400
