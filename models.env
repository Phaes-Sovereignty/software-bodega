# models.env — role → model/CLI mapping (FACTORY-BUILD.md §1)
#
# PROMPT FILES REFERENCE ROLES ONLY, NEVER MODEL NAMES.
# Upgrading a model = edit this file + foreman/routing.yaml. No prompt changes.
#
# Family map drives judge-independence checks:
#   anthropic={claude-*}  xai={grok-*}  openai={codex-*}  moonshot={kimi-*}
# Invariants enforced by scripts/lib/status.sh:family_check and foreman/router.py:
#   family(judge)      != family(executor)     -> judge is cross-family
#   family(plan_judge) != family(planner)      -> plan review is cross-family

# Optional approval override, empty by default. The YOLO launcher sets this to
# 'yolo' so headless stations never pause on a tool gate. It changes ONLY the
# approval prompts -- never the verification, which is the thing being tested.
_APPROVE=""
[ -n "${BODEGA_APPROVAL:-}" ] && _APPROVE="--approval-mode ${BODEGA_APPROVAL}"

# --- RUNTIME: oh-my-pi (omp) for every role ------------------------------
# One binary, four families. Because the CLI no longer identifies the provider,
# FAMILY MUST BE PINNED BY --model: `omp -p` with no --model defaults to
# grok-4.5, which would silently make judge and executor the same family and
# void the independence invariant.
#
# --no-session is load-bearing, not decoration: it maps onto hard rule 1 (one
# task per fresh context window) by guaranteeing no context bleeds between
# tasks. Without it omp would resume prior state.
#
# TOOLS: all enabled (omp default). Worth knowing what that does and does not
# mean, since it was measured rather than assumed:
#   - omp's default approvalMode is 'write', NOT yolo, and it does gate the bash
#     tool. But a model asked to run a shell command routed around that gate via
#     an MCP node-REPL, and writes are not confined to the working directory --
#     a worker wrote to /tmp under every setting tried.
#   - So no in-process setting is a sandbox. Containment in this system is at the
#     git/review layer: selective adds, declared boundaries, the CI scope check,
#     the tamper audit, and nothing self-merging. Real process isolation would
#     have to come from a container or VM.
#
# Prompt delivery is 'arg' for every role: omp takes the prompt as an argument.
# Verified at build time; a prompt starting with '---' (every skill file does)
# makes omp print its usage and exit, so run_role's leading-newline guard
# applies here exactly as it did for grok.
#
# --- executor: writes code (night shift + small loop) ---------------------
EXECUTOR_CMD="omp -p --no-session $_APPROVE --model grok-build"
EXECUTOR_FAMILY='xai'
EXECUTOR_LABEL='executor'
# Prompt delivery: grok -p requires the prompt as an argument (stdin errors out).
# Verified at build time. Prompts stay well under ARG_MAX (~1MB on macOS).
EXECUTOR_INPUT='arg'

# --- planner: interview, spec, blueprint, work order ----------------------
# omp writes files headlessly with no permission flag (verified), so the
# --permission-mode dance the claude CLI needed does not apply.
PLANNER_CMD="omp -p --no-session $_APPROVE --model claude-opus-5"
PLANNER_FAMILY='anthropic'
PLANNER_LABEL='planner'
# stdin: --allowedTools is variadic and would swallow a trailing prompt argument.
PLANNER_INPUT='arg'

# --- judge: inspector + CI review comment --------------------------------
# The judge runs suites (Bash) and writes REVIEW.md. It never edits source:
# that is a prompt-level constraint in skills/inspector, and the inspector's own
# tamper audit is what catches a judge that strays.
JUDGE_CMD="omp -p --no-session $_APPROVE --model claude-opus-5"
JUDGE_FAMILY='anthropic'
JUDGE_LABEL='judge'
JUDGE_INPUT='arg'

# --- plan_judge (the diamond gate): reviews the work order ---------------
PLAN_JUDGE_CMD="omp -p --no-session $_APPROVE --model gpt-5.6-sol"
PLAN_JUDGE_FAMILY='openai'
PLAN_JUDGE_LABEL='plan_judge'
PLAN_JUDGE_INPUT='arg'

# --- glue: diaries, flaky classification, cheap classification -----------
GLUE_CMD="omp -p --no-session $_APPROVE --model grok-4.5"
GLUE_FAMILY='xai'
GLUE_LABEL='glue'
GLUE_INPUT='arg'

# --- triage: classify incoming issues ------------------------------------
TRIAGE_CMD="omp -p --no-session $_APPROVE --model claude-opus-5"
TRIAGE_FAMILY='anthropic'
TRIAGE_LABEL='triage'
TRIAGE_INPUT='arg'

# --- fallback: the last rung of the escalation ladder --------------------
# A FOURTH family, served LOCALLY by llama.cpp. When resample, planner and
# plan_judge have all failed to clear a verify failure, the remaining hypothesis
# is that every model we tried shares a blind spot. A different family is the
# only move left that is not just rolling the same dice again -- and a local one
# keeps working when a hosted quota runs out, which is exactly when a night
# would otherwise die (kimi k3 was the first choice here and was 403 out of
# quota, which is what motivated moving this rung on-disk).
#
# Requires llama-server on 127.0.0.1:12435; see scripts/lib/local-model.sh.
# Invoked ONLY by the escalation ladder on a verify failure -- never routinely.
FALLBACK_CMD='bash scripts/lib/local-model.sh'
FALLBACK_FAMILY='local'
FALLBACK_LABEL='fallback'
FALLBACK_INPUT='arg'

# --- loop limits (FACTORY-BUILD.md hard rule 4) --------------------------
ADAPTER_RETRIES=2     # transport failures (dropped socket, killed adapter).
                      # Separate from REPAIR_CAP: a lost connection says nothing
                      # about the work, so it must not consume a task's chance.
REPAIR_CAP=2          # repairs before resample
RESAMPLE_N=3          # parallel samples, execution-selected
NO_PROGRESS_LIMIT=3   # consecutive empty diffs -> circuit breaker
CONTEXT_ESTIMATE_CAP=100000

# --- watchdog -------------------------------------------------------------
# Hard ceiling on a single role invocation, in seconds. A hung adapter would
# otherwise stall the night indefinitely and bypass every repair cap.
#
# Calibration from the Phase B dry run: the exam-board and work-order stations
# legitimately run 25-40 minutes (they write a dozen files and execute the suite
# between edits), and they are I/O-bound, so low CPU is NOT evidence of a hang —
# check artifact mtimes instead. 1800s killed real work; 3600s is the ceiling
# for a station that has genuinely stopped making progress.
FACTORY_ROLE_TIMEOUT=3600
