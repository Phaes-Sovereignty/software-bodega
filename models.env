# models.env — role → model/CLI mapping (FACTORY-BUILD.md §1)
#
# PROMPT FILES REFERENCE ROLES ONLY, NEVER MODEL NAMES.
# Upgrading a model = edit this file + foreman/routing.yaml. No prompt changes.
#
# Family map drives judge-independence checks:
#   anthropic={claude-*}  xai={grok-*}  openai={codex-*}  moonshot={kimi-*}
# Invariants enforced by scripts/lib/status.sh:family_check and foreman/router.py:
#   family(judge)      != family(executor)     -> judge is cross-family
#   family(plan_judge) != family(planner)      -> plan review is cross-family

# --- executor: writes code (night shift + small loop) ---------------------
# Grok CLI ships a non-interactive mode (`grok -p`), verified at build time,
# so the xAI-API fallback in FACTORY-BUILD.md §1 does NOT apply. See README.
EXECUTOR_CMD='grok -p'
EXECUTOR_FAMILY='xai'
EXECUTOR_LABEL='executor'
# Prompt delivery: grok -p requires the prompt as an argument (stdin errors out).
# Verified at build time. Prompts stay well under ARG_MAX (~1MB on macOS).
EXECUTOR_INPUT='arg'

# --- planner: interview, spec, blueprint, work order ----------------------
# `claude -p` refuses tool use in a non-interactive session unless a permission
# mode is set, so stations that write artifacts need these flags. Verified at
# build time; without them the planner reports "the write was blocked".
PLANNER_CMD='claude -p --output-format json --permission-mode acceptEdits --allowedTools Write,Edit,Read,Bash,Glob,Grep'
PLANNER_FAMILY='anthropic'
PLANNER_LABEL='planner'
# stdin: --allowedTools is variadic and would swallow a trailing prompt argument.
PLANNER_INPUT='stdin'

# --- judge: inspector + CI review comment --------------------------------
# The judge runs suites (Bash) and writes REVIEW.md. It never edits source:
# that is a prompt-level constraint in skills/inspector, and the inspector's own
# tamper audit is what catches a judge that strays.
JUDGE_CMD='claude -p --output-format json --permission-mode acceptEdits --allowedTools Write,Edit,Read,Bash,Glob,Grep'
JUDGE_FAMILY='anthropic'
JUDGE_LABEL='judge'
JUDGE_INPUT='stdin'

# --- plan_judge (the diamond gate): reviews the work order ---------------
PLAN_JUDGE_CMD='codex exec --skip-git-repo-check'
PLAN_JUDGE_FAMILY='openai'
PLAN_JUDGE_LABEL='plan_judge'
PLAN_JUDGE_INPUT='stdin'

# --- glue: diaries, flaky classification, cheap classification -----------
GLUE_CMD='grok -p'
GLUE_FAMILY='xai'
GLUE_LABEL='glue'
GLUE_INPUT='arg'

# --- triage: classify incoming issues ------------------------------------
TRIAGE_CMD='claude -p --output-format json'
TRIAGE_FAMILY='anthropic'
TRIAGE_LABEL='triage'
TRIAGE_INPUT='stdin'

# --- loop limits (FACTORY-BUILD.md hard rule 4) --------------------------
REPAIR_CAP=2          # repairs before resample
RESAMPLE_N=3          # parallel samples, execution-selected
NO_PROGRESS_LIMIT=3   # consecutive empty diffs -> circuit breaker
CONTEXT_ESTIMATE_CAP=100000

# --- watchdog -------------------------------------------------------------
# Hard ceiling on a single role invocation, in seconds. A hung adapter would
# otherwise stall the night indefinitely and bypass every repair cap.
#
# Calibration from the Phase B dry run: the exam-board and work-order stations
# legitimately run 25-40 minutes (they write a dozen files and execute the suite
# between edits), and they are I/O-bound, so low CPU is NOT evidence of a hang —
# check artifact mtimes instead. 1800s killed real work; 3600s is the ceiling
# for a station that has genuinely stopped making progress.
FACTORY_ROLE_TIMEOUT=3600
